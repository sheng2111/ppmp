# MongoDB connection string (local dev or MongoDB Atlas / Render managed MongoDB)
MONGO_URL=mongodb://localhost:27017

# Database name
DB_NAME=ppmp_system

# Secret key (used for token/session signing — change in production)
SECRET_KEY=your-very-secret-key-change-this

# Comma-separated list of allowed browser origins (deployed frontend URL).
# Localhost dev origins are always allowed by the app.
CORS_ORIGINS=https://ppmp-mauve.vercel.app
